{
  "$comment": "A-Team v7 defaults. Read-only inspection + gate commands are pre-allowed; destructive/publish ops ask; force-push and .env reads are denied. Broadened across common toolchains — trim to your stack after /adapt.",
  "permissions": {
    "allow": [
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git branch*)",
      "Bash(git add *)", "Bash(git checkout -b *)", "Bash(git switch*)", "Bash(git worktree*)",
      "Bash(pnpm lint*)", "Bash(pnpm typecheck*)", "Bash(pnpm build*)", "Bash(pnpm test*)",
      "Bash(pnpm exec tsc --noEmit*)", "Bash(pnpm exec vitest run*)", "Bash(pnpm exec biome check*)",
      "Bash(pnpm exec playwright*)", "Bash(pnpm turbo run*)", "Bash(pnpm outdated*)", "Bash(pnpm audit*)",
      "Bash(npm run lint*)", "Bash(npm run typecheck*)", "Bash(npm run build*)", "Bash(npm run test*)",
      "Bash(npm outdated*)", "Bash(npm audit*)",
      "Bash(yarn lint*)", "Bash(yarn build*)", "Bash(yarn test*)",
      "Bash(bun run*)", "Bash(bun test*)",
      "Bash(npx tsc --noEmit*)", "Bash(npx vitest run*)", "Bash(npx biome check*)",
      "Bash(npx playwright test*)", "Bash(npx playwright screenshot*)", "Bash(npx eslint*)", "Bash(npx prettier*)",
      "Bash(npx nx run-many*)", "Bash(npx nx affected*)",
      "Bash(pytest*)", "Bash(ruff*)", "Bash(mypy*)", "Bash(go test*)", "Bash(go vet*)", "Bash(go build*)", "Bash(cargo build*)", "Bash(cargo test*)", "Bash(cargo clippy*)",
      "Bash(supabase status*)", "Bash(supabase db diff*)", "Bash(supabase gen types*)", "Bash(supabase migration list*)", "Bash(supabase start*)", "Bash(supabase stop*)",
      "Bash(npx prisma generate*)", "Bash(npx prisma migrate dev*)", "Bash(npx drizzle-kit generate*)",
      "Bash(node .claude/scripts/*)", "Bash(bash .claude/scripts/*)", "Bash(.claude/scripts/*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(supabase db push*)", "Bash(supabase db reset*)", "Bash(supabase migration up*)",
      "Bash(npx prisma migrate deploy*)", "Bash(npx prisma db push*)",
      "Bash(vercel*)", "Bash(netlify deploy*)", "Bash(fly deploy*)", "Bash(docker push*)"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)",
      "Read(./.env)", "Read(./.env.*)", "Read(./**/.env)", "Read(./**/.env.*)",
      "Bash(cat .env*)", "Bash(cat **/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/path-guard.mjs", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh", "timeout": 60 }
        ]
      }
    ]
  }
}

{
  "$comment": "Auto-detected by detect-stack.mjs. Review with /adapt; low-confidence fields are listed under _confidence.",
  "adapted": true,
  "adaptedAt": "2026-10-13",
  "_confidence": {},
  "language": [
    "typescript"
  ],
  "packageManager": "npm",
  "monorepo": "single-package",
  "scanRoots": [
    "app",
    "components",
    "lib"
  ],
  "frameworks": [
    "next"
  ],
  "gates": {
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm test",
    "build": "npm run build",
    "e2e": "RUN_INTEGRATION=1 npm test -- tests/integration.test.ts"
  },
  "gateFilterFlag": null,
  "db": {
    "kind": "supabase-postgres",
    "schemaChangeCmd": "npx supabase migration new <name>",
    "typegenCmd": null,
    "authzModel": "owner-scoped RLS plus explicitly authorized server-only recipient RPCs"
  },
  "deployTarget": "vercel",
  "designSystem": "native CSS with semantic tokens and lucide icons",
  "secretPatterns": [
    "SERVICE_ROLE",
    "service_role",
    "SECRET_KEY",
    "PRIVATE_KEY",
    "sk_live",
    "AKIA[0-9A-Z]{16}",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----"
  ],
  "clientReachableGlobs": [
    "/app/",
    "/pages/",
    "/components/",
    "/src/client/"
  ],
  "formatter": "auto"
}

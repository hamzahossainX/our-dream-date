# Public project endpoint and public publishable (or local anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix these with NEXT_PUBLIC_ or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=
# Generate: openssl rand -hex 32
INVITATION_SESSION_SECRET=
# Generate a UUID once and use the same value for bootstrap and deployment.
INVITATION_ID=
# Exact origin, e.g. http://localhost:3000 or https://your-domain.example
APP_URL=http://localhost:3000
# Bootstrap only. Existing Supabase Auth user's UUID, never email/password.
ADMIN_USER_ID=
